# Copiez ce fichier en ".env" et completez les valeurs.

# Cle API TheMovieDB (obligatoire pour recuperer les infos/affiches des films)
# A obtenir sur https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Langue des metadonnees TMDb
TMDB_LANGUAGE=fr-FR

# Chemin vers ffprobe si non present dans le PATH systeme.
# Windows exemple : C:\ffmpeg\bin\ffprobe.exe
# Linux : laisser "ffprobe" si installe via le gestionnaire de paquets.
FFPROBE_PATH=ffprobe
